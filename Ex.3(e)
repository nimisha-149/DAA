#include <stdio.h>

int main()
{
    int n, low, high, mid;
    scanf("%d", &n);

    int array[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &array[i]);

    low = 0;
    high = n - 1;

    while (low < high)
    {
        mid = (low + high) / 2;

        if (array[mid] < array[mid + 1])
            low = mid + 1;
        else
            high = mid;
    }

    printf("Peak Index: %d", low);

    return 0;
}
