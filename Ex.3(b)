#include <stdio.h>

int main()
{
    int n, x, low, high, mid, floor = -1;
    scanf("%d", &n);

    int array[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &array[i]);

    scanf("%d", &x);

    low = 0;
    high = n - 1;

    while (low <= high)
    {
        mid = (low + high) / 2;

        if (array[mid] <= x)
        {
            floor = array[mid];
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    printf("%d", floor);

    return 0;
}
