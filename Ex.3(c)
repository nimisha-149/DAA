#include <stdio.h>

int main()
{
    int m, x, low, high, mid;
    scanf("%d", &m);

    int matrix[m][m];

    for (int i = 0; i < m; i++)
        for (int j = 0; j < m; j++)
            scanf("%d", &matrix[i][j]);

    scanf("%d", &x);

    low = 0;
    high = m * m - 1;

    while (low <= high)
    {
        mid = (low + high) / 2;

        if (matrix[mid / m][mid % m] == x)
        {
            printf("FOUND");
            return 0;
        }
        else if (matrix[mid / m][mid % m] < x)
            low = mid + 1;
        else
            high = mid - 1;
    }

    printf("NOT FOUND");

    return 0;
}
