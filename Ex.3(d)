#include <stdio.h>

int main()
{
    int m, low, high, mid, count;
    scanf("%d", &m);

    int array[m];

    for (int i = 0; i < m; i++)
        scanf("%1d", &array[i]);

    low = 0;
    high = m - 1;
    count = 0;

    while (low <= high)
    {
        mid = (low + high) / 2;

        if (array[mid] == 0)
            high = mid - 1;
        else
            low = mid + 1;
    }

    count = m - low;

    printf("%d", count);

    return 0;
}

